#!/usr/bin/env bash

# ask for sudo upfront
if ! sudo -v; then
    echo "Error: sudo authentication failed" >&2
    exit 1
fi

# keep sudo alive while script runs
(
    while true; do
        sudo -n true
        sleep 60
        kill -0 "$$" || exit
    done
) 2>/dev/null &

if [ -z "$NIXOS_ROLE" ]; then
    echo "Error: NIXOS_ROLE is not set." >&2
    exit 1
fi

if ! [[ "$NIXOS_ROLE" =~ ^(server|laptop)$ ]]; then
  echo "Error: unexpected role $NIXOS_ROLE" >&2
  exit 1
fi

if [ -z "$NIXOS_ROOT_MOUNT" ]; then
    NIXOS_ROOT_MOUNT=""
fi

if [ -z "$NIXOS_DIR" ]; then
    echo "Error: NIXOS_DIR is not set." >&2
    exit 1
fi

DIR="$NIXOS_ROOT_MOUNT$NIXOS_DIR"
ROLE="$NIXOS_ROLE"

VARS_DIR="$DIR/vars"
VARS="$VARS_DIR/vars.nix"

case "$ROLE" in
  laptop)
    SOPS_DIR="$NIXOS_ROOT_MOUNT/persist/sops-nix"
    ;;
  server)
    SOPS_DIR="$NIXOS_ROOT_MOUNT/var/lib/sops-nix"
    ;;
  *)
    echo "Error: unexpected role '$ROLE'" >&2
    exit 1
    ;;
esac

SOPS_YAML="$DIR/.sops.yaml"
SECRETS="$VARS_DIR/secrets.yaml"
TEMP_SECRETS="/tmp/sops-nix-init.yaml"

PERSIST_DIR="/persist"
PERSIST_DIR_ROOT="$PERSIST_DIR/root"
PERSIST_DIR_HOME="$PERSIST_DIR_ROOT/home/$USER"

########
# DISKS
########

if [ "$1" == "disks" ]; then


    if ! [ "$ROLE" == "laptop" ]; then
        echo "Error: unexpected role $ROLE" >&2
        exit 1
    fi

    if [ -z "$DISKS_DRY_RUN" ]; then
        DISKS_DRY_RUN="true"
    fi

    if [ -z "$2" ]; then
        echo "Error: expected argument (boot/swap/root/mount)" >&2
        exit 1
    fi

    set -euo pipefail

    : "${BOOT:?Error: BOOT is not set (e.g. /dev/disk/by-partuuid/xxx)}"
    echo "BOOT=$BOOT"
    : "${SWAP:?Error: SWAP is not set (e.g. /dev/disk/by-partuuid/xxx)}"
    echo "SWAP=$SWAP"
    : "${ROOT:?Error: ROOT is not set (e.g. /dev/disk/by-partuuid/xxx)}"
    echo "ROOT=$ROOT"

    DRY_RUN=$DISKS_DRY_RUN
    if [ "$DRY_RUN" == "true" ]; then
      echo "DRY RUN: no destructive actions will be performed. Re-run with DISKS_DRY_RUN=false to actually apply."
    fi

    read -rp "Are you absolutely sure you want to proceed? Type 'I UNDERSTAND' to continue: " CONFIRM
    if [[ "$CONFIRM" != "I UNDERSTAND" ]]; then
      echo "Aborting."
      exit 1
    fi

    # helper for running or echoing
    run() {
    if [ "$DRY_RUN" == "true" ]; then
        echo "+ $*"
      else
        echo "+ $*"; eval "$@"
      fi
    }

    # wait for udev
    run "sudo udevadm settle"

    if [ "$2" == "boot" ]; then

        # 1) format boot as FAT32 (ESP)
        run "sudo mkfs.vfat -F 32 -n BOOT ${BOOT}"

    elif [ "$2" == "swap" ]; then

        # 2) fetup swap
        run "sudo mkswap ${SWAP}"
        run "sudo swapon ${SWAP}"

    elif [ "$2" == "root" ]; then

        # 3) wipe signatures on root before LUKS to avoid troubles
        run "sudo wipefs -a ${ROOT} || true"

        # 4) LUKS encrypt root
        # - use LUKS2, pbkdf=argon2id defaults; prompts for passphrase
        run "sudo cryptsetup luksFormat --type luks2 ${ROOT}"
        run "sudo cryptsetup luksOpen ${ROOT} root"

        # 5) wait for /dev/mapper/root
        run "udevadm settle"

        # 6) create ZFS pool on /dev/mapper/root
        # if re-using disk, consider "zpool destroy -f rpool" first (user responsibility)
        ZPOOL_NAME="rpool"
        ZPOOL_DEVICE="/dev/mapper/root"

        # recommended zpool create options from docs
        ZPOOL_ARGS=(
          -O compression=lz4
          -O xattr=sa
          -O acltype=posixacl
          -O atime=off
          -O mountpoint=none
          -o ashift=12
        )

        # create pool
        run "sudo zpool create ${ZPOOL_NAME} ${ZPOOL_ARGS[*]} ${ZPOOL_DEVICE}"

        # 7) create datasets
        run "sudo zfs create rpool/nixos"
        run "sudo zfs create rpool/nixos/root -o mountpoint=legacy"
        run "sudo zfs create rpool/nixos/home -o mountpoint=legacy"
        run "sudo zfs create rpool/nixos/nix -o mountpoint=legacy"
        run "sudo zfs create rpool/nixos/persist -o mountpoint=legacy"

        # 8) empty snapshots for impermanence
        run "sudo zfs snapshot rpool/nixos/root@blank"
        run "sudo zfs snapshot rpool/nixos/home@blank"

    elif [ "$2" == "mount" ]; then

        # 10) mount filesystems
        run "sudo mkdir -p /mnt"
        run "sudo mount -t zfs rpool/nixos/root /mnt"
        run "sudo mkdir -p /mnt/home /mnt/nix /mnt/persist"
        run "sudo mount -t zfs rpool/nixos/home /mnt/home"
        run "sudo mount -t zfs rpool/nixos/nix /mnt/nix"
        run "sudo mount -t zfs rpool/nixos/persist /mnt/persist"

        # 11) mount boot
        run "sudo mkdir -p /mnt/boot"
        run "sudo mount ${BOOT} /mnt/boot"

    fi

    echo "Done."

########
# CLONE
########

elif [ "$1" == "clone" ]; then

    if ! [[ "$NIXOS_ROLE" =~ ^(server|laptop)$ ]]; then
        echo "Error: unexpected role $NIXOS_ROLE" >&2
        exit 1
    fi

    sudo mkdir -p "$DIR"
    sudo git clone https://github.com/sotormd/nixos "$DIR"
    sudo chown $USER: -R "$DIR"

#######
# VARS
#######

elif [ "$1" == "vars" ]; then

    mkdir -p "$VARS_DIR"

    if [ -f "$VARS" ] && [[ "$2" != "replace" ]]; then
        echo "Error: vars.nix already exists" >&2
        exit 1
    fi

    if [ "$ROLE" == "laptop" ]; then

        : "${VARS_DEVICE_HOSTNAME:="$(uname -n)"}"
        : "${VARS_DEVICE_MACHINEID:="$(cat /etc/machine-id)"}"
        : "${VARS_DEVICE_HOSTID:="$(head -c 8 /etc/machine-id)"}"

        : "${VARS_PARTITIONS_BOOT:="${BOOT##*/}"}"
        : "${VARS_PARTITIONS_SWAP:="${SWAP##*/}"}"
        : "${VARS_PARTITIONS_ROOT:="${ROOT##*/}"}"

        : "${VARS_USER_NAME:="$USER"}"
        : "${VARS_USER_EMAIL:="$USER@$VARS_DEVICE_HOSTNAME"}"
        : "${VARS_USER_GITHUB_KEYFILE:="/home/$VARS_USER_NAME/.ssh/id_ed25519_github"}"
        : "${VARS_USER_CODEBERG_KEYFILE:="/home/$VARS_USER_NAME/.ssh/id_ed25519_codeberg"}"

        : "${VARS_I18N_TIMEZONE:="$(timedatectl show --property=Timezone --value)"}"
        : "${VARS_I18N_KEYBOARD:="us"}"
        : "${VARS_I18N_LOCALE:="en_US.UTF-8"}"

        : "${VARS_NETWORK_INTERFACE:="wlp1s0"}"
        : "${VARS_NETWORK_SSID:="net"}"
        : "${VARS_NETWORK_GATEWAY:="192.168.0.1"}"
        : "${VARS_NETWORK_ADDRESS:="192.168.0.100"}"
        : "${VARS_NETWORK_SERVER_ADDRESS:="192.168.0.200"}"
        : "${VARS_NETWORK_SERVER_DOMAIN:="example.duckdns.org"}"

        : "${VARS_DISPLAYS_LAPTOP_IDENTIFIER:="eDP-1"}"
        : "${VARS_DISPLAYS_LAPTOP_RESOLUTION:="1920x1200"}"
        : "${VARS_DISPLAYS_LAPTOP_REFRESH:="60Hz"}"
        : "${VARS_DISPLAYS_LAPTOP_POSITION:="0 0"}"

        : "${VARS_DISPLAYS_MONITOR_IDENTIFIER:="HDMI-A-1"}"
        : "${VARS_DISPLAYS_MONITOR_RESOLUTION:="1920x1080"}"
        : "${VARS_DISPLAYS_MONITOR_REFRESH:="60Hz"}"
        : "${VARS_DISPLAYS_MONITOR_POSITION:="1920 0"}"

        # create vars file
        cat > "$VARS" <<EOF
{
  flake = {
    nixosDirectory = "$NIXOS_DIR";
    nixosRole = "laptop";
  };

  device = {
    hostName = "$VARS_DEVICE_HOSTNAME";
    machineId = "$VARS_DEVICE_MACHINEID";
    hostId = "$VARS_DEVICE_HOSTID";
  };

  partitions = {
    boot = "$VARS_PARTITIONS_BOOT";
    swap = "$VARS_PARTITIONS_SWAP";
    root = "$VARS_PARTITIONS_ROOT";
  };

  filesystem = {
    luks = { };
    mount = { };
    hdparm = [ ];
  };

  user = {
    name = "$VARS_USER_NAME";
    email = "$VARS_USER_EMAIL";
    sshAliases = {
      github = {
        user = "git";
        host = "github.com";
        port = 22;
        keyfile = "$VARS_USER_GITHUB_KEYFILE";
      };
      codeberg = {
        user = "git";
        host = "codeberg.org";
        port = 22;
        keyfile = "$VARS_USER_CODEBERG_KEYFILE";
      };
    };
  };

  i18n = {
    timeZone = "$VARS_I18N_TIMEZONE";
    keyboard = "$VARS_I18N_KEYBOARD";
    locale = "$VARS_I18N_LOCALE";
  };

  network = {
    interface = "$VARS_NETWORK_INTERFACE";
    ssid = "$VARS_NETWORK_SSID";
    gateway = "$VARS_NETWORK_GATEWAY";
    address = "$VARS_NETWORK_ADDRESS";
    server = {
      address = "$VARS_NETWORK_ADDRESS";
      domain = "$VARS_NETWORK_DOMAIN";
    };
  };

  displays = {
    outputs = {
      laptop = {
        identifier = "$VARS_DISPLAYS_LAPTOP_IDENTIFIER";
        resolution = "$VARS_DISPLAYS_LAPTOP_RESOLUTION";
        refresh = "$VARS_DISPLAYS_LAPTOP_REFRESH";
        position = "$VARS_DISPLAYS_LAPTOP_POSITION";
      };
      monitor = {
        identifier = "$VARS_DISPLAYS_MONITOR_IDENTIFIER";
        resolution = "$VARS_DISPLAYS_MONITOR_RESOLUTION";
        refresh = "$VARS_DISPLAYS_MONITOR_REFRESH";
        position = "$VARS_DISPLAYS_MONITOR_POSITION";
      };
    };
    primary = "monitor";
  };

  features = {
    secureboot.enable = false;
    impermanence.enable = false;
    selfhosted.enable = false;
  };
}
EOF

    elif [ "$ROLE" == "server" ]; then

        : "${VARS_DEVICE_HOSTNAME:="$(uname -n)"}"
        : "${VARS_DEVICE_MACHINEID:="$(cat /etc/machine-id)"}"
        : "${VARS_DEVICE_HOSTID:="$(head -c 8 /etc/machine-id)"}"

        : "${VARS_PARTITIONS_ROOT:="2178694e-02"}"

        : "${VARS_USER_NAME:="$USER"}"
        : "${VARS_USER_EMAIL:="$USER@$VARS_DEVICE_HOSTNAME"}"

        : "${VARS_I18N_TIMEZONE:="$(timedatectl show --property=Timezone --value)"}"
        : "${VARS_I18N_KEYBOARD:="us"}"
        : "${VARS_I18N_LOCALE:="en_US.UTF-8"}"

        : "${VARS_NETWORK_INTERFACE:="wlan0"}"
        : "${VARS_NETWORK_SSID:="net"}"
        : "${VARS_NETWORK_GATEWAY:="192.168.0.1"}"
        : "${VARS_NETWORK_ADDRESS:="192.168.0.200"}"
        : "${VARS_NETWORK_RANGE:="192.168.0.0/24"}"
        : "${VARS_NETWORK_DOMAIN:="$VARS_DEVICE_HOSTNAME-server.duckdns.org"}"
        : "${VARS_NETWORK_SSH_PORT:="22"}"
        : "${VARS_NETWORK_SSH_KEY:=}"

        # create vars file
        cat > "$VARS" <<EOF
{
  flake = {
    nixosDirectory = "$NIXOS_DIR";
    nixosRole = "server";
  };

  device = {
    hostName = "$VARS_DEVICE_HOSTNAME";
    machineId = "$VARS_DEVICE_MACHINEID";
    hostId = "$VARS_DEVICE_HOSTID";
  };

  partitions = {
    root = "$VARS_PARTITIONS_ROOT";
  };

  filesystem = {
    luks = { };
    mount = { };
    hdparm = [ ];
  };

  user = {
    name = "$VARS_USER_NAME";
    email = "$VARS_USER_EMAIL";
  };

  i18n = {
    timeZone = "$VARS_I18N_TIMEZONE";
    keyboard = "$VARS_I18N_KEYBOARD";
    locale = "$VARS_I18N_LOCALE";
  };

  network = {
    interface = "$VARS_NETWORK_INTERFACE";
    ssid = "$VARS_NETWORK_SSID";
    gateway = "$VARS_NETWORK_GATEWAY";
    address = "$VARS_NETWORK_ADDRESS";
    range = "$VARS_NETWORK_RANGE";
    domain = "$VARS_NETWORK_DOMAIN";
    ssh = {
      port = $VARS_NETWORK_SSH_PORT;
      keys = [ "$VARS_NETWORK_SSH_KEY" ];
    };
  };

  services = {
    unbound.enable = false;
    nginx.enable = false;
    searxng.enable = false;
    vaultwarden.enable = false;
    i2pd.enable = false;
    qbt.enable = false;
    jellyfin.enable = false;
  };
}
EOF

    fi

    # set permissions for vars file
    sudo chmod 600 "$VARS"

#######
# SOPS
#######

elif [ "$1" == "sops" ]; then

    mkdir -p "$VARS_DIR"

    if [ -f "$SECRETS" ] && [[ "$2" != "replace" ]]; then
        echo "Error: secrets.yaml already exists" >&2
        exit 1
    fi

    # check environment variables
    if [ -z "$SECRETS_HASHED_PASSWORD" ]; then

        while true; do
            echo
            echo "Set user account password"
            read -sp "Enter password  : " PASSWORD1
            echo
            read -sp "Confirm password: " PASSWORD2
            echo

            if [ "$PASSWORD1" == "$PASSWORD2" ]; then
                SECRETS_HASHED_PASSWORD=$(mkpasswd "$PASSWORD1" -m yescrypt)
                break
            else
                echo "Passwords do not match, try again"
            fi
        done
    fi

    if [ -z "$SECRETS_PSK" ]; then

        while true; do
            echo
            echo "Set wireless network password"
            read -sp "Enter password  : " PASSWORD1
            echo
            read -sp "Confirm password: " PASSWORD2
            echo

            if [ "$PASSWORD1" == "$PASSWORD2" ]; then
                SECRETS_PSK="$PASSWORD1"
                break
            else
                echo "Passwords do not match, try again"
            fi
        done
    fi

    if [ "$ROLE" == "server" ]; then

        if [ -z "$SECRETS_DUCKDNS_TOKEN" ]; then
            SECRETS_DUCKDNS_TOKEN=""
        fi

        if [ -z "$SECRETS_SEARXNG_KEY" ]; then
            SECRETS_SEARXNG_KEY=$(head -c 64 /dev/urandom | sha256sum | cut -d ' ' -f1)
        fi

    fi

    # delete existing sops keys from gpg
    if [ -f "$SOPS_YAML" ]; then
        FINGERPRINT=$(yq '.keys[0]' $SOPS_YAML)
        FINGERPRINT="${FINGERPRINT#\"}"
        FINGERPRINT="${FINGERPRINT%\"}"
        sudo GNUPGHOME=$SOPS_DIR gpg --batch --yes --delete-secret-keys $FINGERPRINT
        sudo GNUPGHOME=$SOPS_DIR gpg --batch --yes --delete-key $FINGERPRINT
    fi

    # delete old sops-nix directory if exists
    if [ -d "$SOPS_DIR" ]; then
        sudo rm -rf "$SOPS_DIR"
    fi
    sudo mkdir -p "$SOPS_DIR"

    # change ownership of sops-nix directory
    sudo chown root: "$SOPS_DIR"
    sudo chmod 700 "$SOPS_DIR"

    rm -rf /tmp/sops-nix

    # create new gpg key for sops-nix
    # save key fingerprint
    FINGERPRINT=$(nix run github:Mic92/sops-nix#sops-init-gpg-key -- --gpghome "/tmp/sops-nix" --keytype Curve25519 2>&1 | grep -oP '(?<=fingerprint:\s)\S+')

    # ensure non-empty key
    if [ -z "$FINGERPRINT" ]; then
        echo "Error: Failed to generate a GPG key for sops-nix" >&2
        exit 1
    fi

    # move key to the sops-nix directory
    sudo cp -r /tmp/sops-nix/** "$SOPS_DIR"

    # export the gpg key from sops-nix directory
    sudo GNUPGHOME=$SOPS_DIR gpg --export --armor > /tmp/sops-nix-pub.asc
    sudo GNUPGHOME=$SOPS_DIR gpg --export-secret-keys --armor > /tmp/sops-nix-priv.asc

    # securely purge keys
    shred /tmp/sops-nix-pub.asc -u
    shred /tmp/sops-nix-priv.asc -u
    find /tmp/sops-nix -type f -exec shred -u {} +
    rm -rf /tmp/sops-nix

    # create .sops.yaml configuration file
    cat > "$SOPS_YAML" <<EOF
keys:
  - &personal $FINGERPRINT
creation_rules:
  - path_regex: $(echo $SECRETS | sed "s|^$DIR/||")
    key_groups:
    - pgp:
      - *personal
  - path_regex: $TEMP_SECRETS
    key_groups:
    - pgp:
      - *personal
EOF

    #create the secrets file
    if [ "$ROLE" == "laptop" ]; then

        cat > "$TEMP_SECRETS" <<EOF
hashedPassword: $SECRETS_HASHED_PASSWORD
network: |
  psk=$SECRETS_PSK
EOF

    elif [ "$ROLE" == "server" ]; then

        cat > "$TEMP_SECRETS" <<EOF
hashedPassword: $SECRETS_HASHED_PASSWORD
network: |
  psk=$SECRETS_PSK
duckdns: |
  DUCKDNS_TOKEN=$SECRETS_DUCKDNS_TOKEN
searxng: |
  SEARXNG_SECRET=$SECRETS_SEARXNG_KEY
EOF

    fi

    # open secrets file
    (
        cd "$DIR" || exit
        sudo GNUPGHOME=$SOPS_DIR sops -e $TEMP_SECRETS > $SECRETS
        shred "$TEMP_SECRETS" -u
    )

    # set permissions for secrets file
    sudo chmod 600 "$SECRETS"

##########
# INSTALL
##########

elif [ "$1" == "install" ]; then

    if ! [ "$ROLE" == "laptop" ]; then
        echo "Error: unexpected role $ROLE" >&2
        exit 1
    fi

    if ! [ "$NIXOS_ROOT_MOUNT" == "/mnt" ]; then
        echo "Error: unexpected root mount $NIXOS_ROOT_MOUNT"
        exit 1
    fi

    (
        cd "$DIR"
        git add .

        sudo nixos-install --root "$NIXOS_ROOT_MOUNT" --flake "$DIR#$ROLE" --no-root-passwd

        git reset -- vars/vars.nix vars/secrets.yaml .sops.yaml
    )

#############
# LANZABOOTE
#############

elif [ "$1" == "lanzaboote" ]; then

    if ! [ "$ROLE" == "laptop" ]; then
        echo "Error: unexpected role $ROLE" >&2
        exit 1
    fi

    if [ "$2" == "create" ]; then
        nix shell nixpkgs#sbctl --command sudo sbctl create-keys
    fi

    if [ "$2" == "enroll" ]; then
        nix shell nixpkgs#sbctl --command sudo sbctl enroll-keys --microsoft
    fi

###############
# IMPERMANENCE
###############

elif [ "$1" == "impermanence" ]; then

    if ! [ "$ROLE" == "laptop" ]; then
        echo "Error: unexpected role $ROLE" >&2
        exit 1
    fi

    if [ ! -d "$PERSIST_DIR" ]; then
        echo "Error: $PERSIST_DIR doesn't exist" >&2
        exit 1
    fi

    if [ -d "$PERSIST_DIR_ROOT" ]; then
        echo "Error: $PERSIST_DIR_ROOT already exists" >&2
        exit 0
    fi

    if [ -d "$PERSIST_DIR_HOME" ]; then
        echo "Error: $PERSIST_DIR_HOME already exists" >&2
        exit 0
    fi

    # ROOT
    sudo mkdir "$PERSIST_DIR_ROOT"

    # zpool.cache
    sudo mkdir -p "$PERSIST_DIR_ROOT/etc/zfs"
    sudo cp -a /etc/zfs/zpool.cache "$PERSIST_DIR_ROOT/etc/zfs/zpool.cache"

    # /var/lib/nixos
    sudo mkdir -p "$PERSIST_DIR_ROOT/var/lib"
    sudo cp -a /var/lib/nixos "$PERSIST_DIR_ROOT/var/lib/nixos"

    # /var/lib/systemd
    sudo mkdir -p "$PERSIST_DIR_ROOT/var/lib"
    sudo cp -a /var/lib/systemd "$PERSIST_DIR_ROOT/var/lib/systemd"

    # /var/lib/sbctl
    sudo mkdir -p "$PERSIST_DIR_ROOT/var/lib"
    sudo cp -a /var/lib/sbctl "$PERSIST_DIR_ROOT/var/lib/sbctl"

    # /var/log
    sudo mkdir -p "$PERSIST_DIR_ROOT/var"
    sudo cp -a /var/log "$PERSIST_DIR_ROOT/var/log"

    sudo chown -R root: "$PERSIST_DIR_ROOT"

    # HOME
    sudo mkdir -p "$PERSIST_DIR_HOME"

    # directories in $HOME
    # may not exist yet, so
    # we need to create empty
    # directories with mkdir -p

    # Documents
    sudo cp -a "$HOME/Documents" "$PERSIST_DIR_HOME/Documents"
    sudo mkdir -p "$PERSIST_DIR_HOME/Documents"

    # Downloads
    sudo cp -a "$HOME/Downloads" "$PERSIST_DIR_HOME/Downloads"
    sudo mkdir -p "$PERSIST_DIR_HOME/Downloads"

    # Pictures
    sudo cp -a "$HOME/Pictures" "$PERSIST_DIR_HOME/Pictures"
    sudo mkdir -p "$PERSIST_DIR_HOME/Pictures"

    # Projects
    sudo cp -a "$HOME/Projects" "$PERSIST_DIR_HOME/Projects"
    sudo mkdir -p "$PERSIST_DIR_HOME/Projects"

    # Brave Browser
    sudo mkdir -p "$PERSIST_DIR_HOME/.config/BraveSoftware"
    sudo cp -a "$HOME/.config/BraveSoftware/Brave-Browser" "$PERSIST_DIR_HOME/.config/BraveSoftware/Brave-Browser"
    sudo mkdir -p "$PERSIST_DIR_HOME/.config/BraveSoftware/Brave-Browser"

    # SSH
    sudo cp -a "$HOME/.ssh" "$PERSIST_DIR_HOME/.ssh"
    sudo mkdir -p "$PERSIST_DIR_HOME/.ssh"

    sudo chown -R $USER: "$PERSIST_DIR_HOME"

    sudo chmod -R 600 "$PERSIST_DIR_HOME/.ssh"
    sudo chmod 700 "$PERSIST_DIR_HOME/.ssh"

fi
