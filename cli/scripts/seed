#!/usr/bin/env bash

set -euo pipefail

KEY="/run/secrets/seed"

HOST=${1:-}

if [ "$HOST" == "" ]; then
    
    run0 cat "$KEY" | nix key convert-secret-to-public

else

    mount=$(ssh "$HOST" 'printf "%s" "$NIXOS_MOUNT"')
    role=$(ssh "$HOST" 'printf "%s" "$NIXOS_ROLE"')
    arch=$(ssh "$HOST" 'nix eval --impure --raw --expr builtins.currentSystem')
    nonflake=$(ssh "$HOST" 'printf "%s" "$NIXOS_NONFLAKE"')
    if [ -z "$role" ]; then
        echo "NIXOS_ROLE is not set on $HOST" >&2
        exit 1
    fi

    sourcedir=$(mktemp -d)
    workdir=$(mktemp -d)

    cleanup() {
        rm -rf "$sourcedir" "$workdir"
    }
    trap cleanup INT TERM EXIT

    rsync -avz --exclude=".git" "$HOST:$mount$__NIXOS_GLOBALS_FLAKE" "$sourcedir"

    (

        cd "$workdir"

        if [ "$nonflake" = 1 ]; then
            nixos-rebuild build --file "$sourcedir/nonflake.nix" --attr "nixosConfigurations.machine-$role-$arch" --fallback
        else
            target=""
            nixos-rebuild build --flake "$sourcedir#machine-$role-$arch" --fallback
        fi

        run0 nix store sign ./result -k "$KEY" --recursive
        nix copy --to "ssh://$HOST" ./result

    )

fi
