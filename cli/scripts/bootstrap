  };

  # additional filesystem mounts
  filesystem = {

    # configure luks encrypted devices
    # each entry should have a uuid and keyfile
    luks = { };

    # configure mounts
    # directly map to fileSystems.* blocks
    mount = {

      # raw mounts, no additional options
      raw = { };

      # nosuid, nodev
      harden = { };

      # nosuid, nodev, noexec
      data = { };

      # nosuid, nodev, ro
      immutable = { };

      # nosuid, nodev, noexec, ro
      static = { };

    };

  };

  # usbguard allowed devices
  # all others are blocked
  usbs = [ ];

  # user information
  user = {

    # nsswitch username in /etc/passwd
    name = "example";

  };

  # localization and internationalization
  localization = {

    # Continent/City timezone
    timeZone = "UTC";

    # keyboard layout
    keyboard = "us";

    # locale
    locale = "en_US.UTF-8";

  };

  # networking options
  network = {

    # primary DNS resolver
    resolver = "127.0.0.1";

    # wpa_supplicant wireless networking
    wireless = {

      # wireless NIC identifier
      interface = "wlp1s0";

      # wireless network ssid
      ssid = "example";

      # wireless network gateway
      gateway = "10.0.0.1";

      # static IP address
      address = "10.0.0.2";

    };

    # wireguard vpn
    wireguard = {

      # wireguard address
      address = "10.20.0.2";

      # wireguard port
      port = 51820;

      # wireguard peers
      peers = [ ];

    };

  };

  # additional feature toggles
  features = {

    # secureboot with lanzaboote
    secureboot.enable = false;

    # impermanence with ZFS and bind mounts
    impermanence.enable = false;

  };

  # service toggles
  services = {

    # dnscrypt-proxy DoH
    # loopback service
    dnscrypt = {
      enable = true;
    };

    # ssh server
    # lan service
    #
    # port is a port
    # trusted-keys is a list of ed25519 ssh public keys
    # allow is a private CIDR (LAN)
    ssh = {
      enable = false;
      port = 2222;
      trusted-keys = [ ];
      allow = "10.0.0.4/32";
    };

    # nginx web server
    # svcvm service
    #
    # staging is to use Let's Encrypt staging
    # email is address used for acme
    # domain is a duckdns domain
    # allow is a private CIDR (wireguard)
    # debug is whether to allow debugging
    nginx = {
      enable = false;
      staging = false;
      email = "example@example";
      domain = "example.duckdns.org";
      allow = "10.20.0.2/32";
      debug = true;
    };

    # searxng metasearch engine
    # svcvm service
    #
    # allow is a private CIDR (wireguard)
    # debug is whether to allow debugging
    searxng = {
      enable = false;
      allow = "10.20.0.2/32";
      debug = true;
    };

    # vaultwarden password manager
    # svcvm service
    #
    # signups is whether to allow new signups
    # allow is a private CIDR (wireguard)
    # debug is whether to allow debugging
    vaultwarden = {
      enable = false;
      signups = false;
      allow = "10.20.0.2/32";
      debug = true;
    };

    # i2pd router
    # svcvm service
    #
    # allow is a private CIDR (wireguard)
    # debug is whether to allow debugging
    i2pd = {
      enable = false;
      allow = "10.20.0.2/32";
      debug = true;
    };

    # qbittorrent bittorrent client
    # svcvm service
    #
    # allow is a private CIDR (wireguard)
    # debug is whether to allow debugging
    qbt = {
      enable = false;
      allow = "10.20.0.2/32";
      debug = true;
    };

  };

  # seed this machine remotely
  # trusted-keys is a list of nix public keys
  seed = {
    enable = false;
    trusted-keys = [ ];
  };

}
EOF

        echo 'before rebuilding, ensure that all variables are properly defined
invalid / inaccurate variables can lead to a broken system
bootstrap DOES NOT POPULATE VARIABLES with sane values, only examples

the following values have been populated from the installation environment
- device.machineId
- device.hostId
- partitions.boot
- partitions.swap
- partitions.root'


    elif [[ "${ROLE:-}" =~ ^(pi)$ ]]; then

        # create vars file
        cat > "$VARS" <<EOF
# variables are used to capture differences in hosts using the same role

# this file was automatically generated during bootstrap
# use this file to store variables consumed by the flake

# note that variables end up in the world-readable nix store
# use sops-nix secrets for sensitive information

# before rebuilding, ensure that all variables are properly defined
# invalid / inaccurate variables can lead to a broken system
# bootstrap DOES NOT POPULATE VARIABLES with sane values, only examples

# the following values have been populated from the installation environment
# - device.machineId
# - device.hostId

{
  # device variables
  device = {

    # hostname in /etc/hostname
    hostName = "example";

    # machine id in /etc/machine-id
    # required by systemd for consistent logs
    # passed as a boot parameter
    machineId = "$MACHINE_ID";

    # host id
    # required by ZFS
    hostId = "$HOST_ID";

  };

  # partition PARTUUIDS
  # get these from /dev/disk/by-partuuid/...
  partitions = {

    # root partition
    root = "2178694e-02";

  };

  # additional filesystem mounts
  filesystem = {

    # configure luks encrypted devices
    # each entry should have a uuid and keyfile
    luks = { };

    # configure mounts
    # directly map to fileSystems.* blocks
    mount = {

      # raw mounts, no additional options
      raw = { };

      # nosuid, nodev
      harden = { };

