EOF

        echo 'before rebuilding, ensure that all variables are properly defined
invalid / inaccurate variables can lead to a broken system
bootstrap DOES NOT POPULATE VARIABLES with sane values, only examples

the following values have been populated from the installation environment
- device.machineId
- device.hostId'

    fi

    # set permissions for vars file
    sudo chmod 600 "$VARS"

#######
# SOPS
####### workstation, server, pi

elif [ "$VERB" == "sops" ]; then

    # allowed roles: workstation, server, pi
    if ! [[ "${ROLE:-}" =~ ^(workstation|server|pi)$ ]]; then
      echo "Error: unexpected role $ROLE" >&2
      exit 1
    fi

    mkdir -p "$VARS_DIR"

    if [ -f "$SECRETS" ] && [[ "$ARG1" != "replace" ]]; then
        echo "Error: secrets.yaml already exists" >&2
        exit 1
    fi

    # check environment variables
    if [ -z "${SECRETS_HASHED_PASSWORD:-}" ]; then
        echo "SECRETS_HASHED_PASSWORD unset, using user input"

        while true; do
            echo "Set user account password"
            read -sp "Enter password  : " PASSWORD1
            echo
            read -sp "Confirm password: " PASSWORD2
            echo
            echo

            if [ "$PASSWORD1" == "$PASSWORD2" ]; then
                SECRETS_HASHED_PASSWORD=$(mkpasswd "$PASSWORD1" -m yescrypt)
                break
            else
                echo "Passwords do not match, try again"
            fi
        done
    fi

    if [ -z "${SECRETS_WIRELESS_PSK:-}" ]; then
        echo "SECRETS_WIRELESS_PSK unset, using user input"

        while true; do
            echo "Set wireless network password"
            read -sp "Enter password  : " PASSWORD1
            echo
            read -sp "Confirm password: " PASSWORD2
            echo
            echo

            if [ "$PASSWORD1" == "$PASSWORD2" ]; then
                SECRETS_WIRELESS_PSK="$PASSWORD1"
                break
            else
                echo "Passwords do not match, try again"
            fi
        done
    fi

    if [ -z "${SECRETS_SEED_KEY:-}" ]; then
        echo "SECRETS_SEED_KEY unset, generating new"
        SECRETS_SEED_KEY=$(nix key generate-secret --key-name seed)
    fi

    if [ -z "${SECRETS_WIREGUARD_KEY:-}" ]; then
        echo "SECRETS_WIREGUARD_KEY unset, generating new"
        SECRETS_WIREGUARD_KEY="$(wg genkey)"
    fi

    if [[ "${ROLE:-}" =~ ^(server)$ ]]; then

        if [ -z "${SECRETS_DUCKDNS_TOKEN:-}" ]; then
            echo "SECRETS_DUCKDNS_TOKEN unset, left empty"
            SECRETS_DUCKDNS_TOKEN=""
        fi

        if [ -z "${SECRETS_SEARXNG_KEY:-}" ]; then
            echo "SECRETS_SEARXNG_KEY unset, generating new"
            SECRETS_SEARXNG_KEY=$(head -c 64 /dev/urandom | sha256sum | cut -d ' ' -f1)
        fi

    fi

    # delete existing sops keys from gpg
    if [ -f "$SOPS_YAML" ]; then
        FINGERPRINT=$(yq '.keys[0]' "$SOPS_YAML")
        FINGERPRINT="${FINGERPRINT#\"}"
        FINGERPRINT="${FINGERPRINT%\"}"
        sudo GNUPGHOME="$SOPS_DIR" gpg --batch --yes --delete-secret-keys "$FINGERPRINT" || true
        sudo GNUPGHOME="$SOPS_DIR" gpg --batch --yes --delete-key "$FINGERPRINT" || true
    fi

    # delete old sops-nix directory if exists
    if [ -d "$SOPS_DIR" ]; then
        sudo rm -rf "$SOPS_DIR"
    fi
    sudo mkdir -p "$SOPS_DIR"

    # change ownership of sops-nix directory
    sudo chown root: "$SOPS_DIR"
    sudo chmod 700 "$SOPS_DIR"

    rm -rf /tmp/sops-nix

    # create new gpg key for sops-nix
    # save key fingerprint
    FINGERPRINT=$(nix run github:Mic92/sops-nix#sops-init-gpg-key -- --gpghome "/tmp/sops-nix" --keytype Curve25519 2>&1 | grep -oP '(?<=fingerprint:\s)\S+' | tail -n1)

    # ensure non-empty key
    if [ -z "$FINGERPRINT" ]; then
        echo "Error: Failed to generate a GPG key for sops-nix" >&2
        exit 1
    fi

    # move key to the sops-nix directory
    sudo cp -r /tmp/sops-nix/. "$SOPS_DIR/"

    # export the gpg key from sops-nix directory
    sudo GNUPGHOME="$SOPS_DIR" gpg --export --armor > /tmp/sops-nix-pub.asc
    sudo GNUPGHOME="$SOPS_DIR" gpg --export-secret-keys --armor > /tmp/sops-nix-priv.asc

    # securely purge keys
    shred /tmp/sops-nix-pub.asc -u
    shred /tmp/sops-nix-priv.asc -u
    find /tmp/sops-nix -type f -exec shred -u {} +
    rm -rf /tmp/sops-nix

    # create .sops.yaml configuration file
    cat > "$SOPS_YAML" <<EOF
keys:
  - &personal $FINGERPRINT
creation_rules:
  - path_regex: $(echo "$SECRETS" | sed "s|^$DIR/||")
    key_groups:
    - pgp:
      - *personal
  - path_regex: $TEMP_SECRETS
    key_groups:
    - pgp:
      - *personal
EOF

    #create the secrets file
    if [[ "${ROLE:-}" =~ ^(workstation|pi)$ ]]; then

        cat > "$TEMP_SECRETS" <<EOF
hashedPassword: $SECRETS_HASHED_PASSWORD

wireguard: $SECRETS_WIREGUARD_KEY

wireless: |
  psk=$SECRETS_WIRELESS_PSK

seed: $SECRETS_SEED_KEY
EOF

    elif [[ "${ROLE:-}" =~ ^(server)$ ]]; then

        cat > "$TEMP_SECRETS" <<EOF
hashedPassword: $SECRETS_HASHED_PASSWORD

wireguard: $SECRETS_WIREGUARD_KEY

wireless: |
  psk=$SECRETS_WIRELESS_PSK

seed: $SECRETS_SEED_KEY

duckdns: |
  DUCKDNS_TOKEN=$SECRETS_DUCKDNS_TOKEN

searxng: |
  SEARXNG_SECRET=$SECRETS_SEARXNG_KEY
EOF

    fi

    # open secrets file
    (
        cd "$DIR" || exit
        sudo GNUPGHOME="$SOPS_DIR" sops -e "$TEMP_SECRETS" > "$SECRETS"
        shred "$TEMP_SECRETS" -u
    )

    # set permissions for secrets file
    sudo chmod 600 "$SECRETS"

##########
# INSTALL
########## workstation, server

elif [ "$VERB" == "install" ]; then

    # allowed roles: workstation, server
    if ! [[ "${ROLE:-}" =~ ^(workstation|server)$ ]]; then
      echo "Error: unexpected role $ROLE" >&2
      exit 1
    fi


    if ! [ "$MOUNT" == "/mnt" ]; then
        echo "Error: unexpected root mount $MOUNT"
        exit 1
    fi

    (
        cd "$DIR"
        git add .

        if [ "$NONFLAKE" = 1 ]; then
            sudo nixos-install --root "$MOUNT" --file "nonflake.nix" --attr "nixosConfigurations.machine-$ROLE-$ARCH" --no-root-passwd
        else
            sudo nixos-install --root "$MOUNT" --flake ".#machine-$ROLE-$ARCH" --no-root-passwd
        fi

        git reset -- vars/vars.nix vars/secrets.yaml .sops.yaml
    )

##########
# FINISH
######### workstation, server

elif [ "$VERB" == "finish" ]; then

    # allowed roles: workstation, server
    if ! [[ "${ROLE:-}" =~ ^(workstation|server)$ ]]; then
      echo "Error: unexpected role $ROLE" >&2
      exit 1
    fi


    if ! [ "$MOUNT" == "/mnt" ]; then
        echo "Error: unexpected root mount $MOUNT"
        exit 1
    fi

    sudo umount -l /mnt/boot || true
    sudo umount -l /mnt/persist || true
    sudo umount -l /mnt/nix || true
    sudo umount -l /mnt || true
    sudo zpool export rpool -f

############# post-install
# LANZABOOTE
############# workstation, server

elif [ "$VERB" == "lanzaboote" ]; then

    # allowed roles: workstation, server
    if ! [[ "${ROLE:-}" =~ ^(workstation|server)$ ]]; then
      echo "Error: unexpected role $ROLE" >&2
      exit 1
    fi

    if ! [ "$MOUNT" == "" ]; then
        echo "Error: unexpected root mount $MOUNT"
        exit 1
    fi

    if [ "$ARG1" == "create" ]; then
        nix shell nixpkgs#sbctl --command sudo sbctl create-keys
    fi

    if [ "$ARG1" == "enroll" ]; then
        nix shell nixpkgs#sbctl --command sudo sbctl enroll-keys --microsoft
    fi

############### post-install
# IMPERMANENCE
############### workstation, server, pi

elif [ "$VERB" == "impermanence" ]; then

    # allowed roles: workstation, server, pi
    if ! [[ "${ROLE:-}" =~ ^(workstation|server|pi)$ ]]; then
      echo "Error: unexpected role $ROLE" >&2
      exit 1
    fi

    if ! [ "$MOUNT" == "" ]; then
        echo "Error: unexpected root mount $MOUNT"
        exit 1
    fi

    if [ -n "$(sudo ls -A -- "$PERSIST_DIR_ROOT" 2>/dev/null)" ]; then
        echo "Error: $PERSIST_DIR_ROOT is not empty" >&2
        exit 1
    fi

    # ROOT
    sudo mkdir -p "$PERSIST_DIR_ROOT"

    # helper function
    persist_dirs() {
        local dest_base="$1"
        local src_root="$2"
        shift 2
        local sources=("$@")

        for src in "${sources[@]}"; do
            # strip leading slash
            local rel="${src#/}"

            # real source path
            local real_src="$src_root/$rel"

            # destination path
            local dest="$dest_base/$rel"

            # 1. create parent
            sudo mkdir -p "$(dirname "$dest")"

            # 2. copy if exists
            if [ -e "$real_src" ]; then
                sudo cp -a "$real_src" "$dest"
            fi

            # 3. ensure destination exists
            sudo mkdir -p "$dest"
        done
    }

    # set permissions
    sudo chown -R root: "$PERSIST_DIR_ROOT"

    # HOME
    sudo mkdir -p "$PERSIST_DIR_HOME"

    if [[ "${ROLE:-}" =~ ^(workstation)$ ]]; then

        # populate /persist/root/
        echo "Populating /persist/root/"
        persist_dirs "$PERSIST_DIR_ROOT" "$MOUNT$REAL_ROOT" \
            "/var/lib/nixos" \
            "/var/lib/systemd" \
            "/var/lib/sbctl" \
            "/var/lib/libvirt" \
            "/var/log" \
            "/etc/zfs" \
            "/etc/ssh"

        # populate /persist/root/home/
        echo "Populating /persist/root/home/"
        persist_dirs "$PERSIST_DIR_HOME" "$MOUNT$REAL_HOME" \
            "/Documents" \
            "/Downloads" \
            "/Pictures" \
            "/Projects" \
            "/.config/BraveSoftware/Brave-Browser" \
            "/.ssh" \
            "/.local/share/containers" \
            "/.local/state/nix"

    elif [[ "${ROLE:-}" =~ ^(server)$ ]]; then
        
        # populate /persist/root/
        echo "Populating /persist/root/"
        persist_dirs "$PERSIST_DIR_ROOT" "$MOUNT$REAL_ROOT"  \
            "/var/lib/nixos" \
            "/var/lib/systemd" \
            "/var/lib/sbctl" \
            "/var/lib/acme" \
            "/var/lib/bitwarden_rs" \
            "/var/lib/i2pd" \
            "/var/lib/qbt" \
            "/var/log" \
            "/etc/zfs" \
            "/etc/ssh" \
            "/srv/static" \
            "/srv/torrents"

    elif [[ "${ROLE:-}" =~ ^(pi)$ ]]; then
        
        # populate /persist/root/
        echo "Populating /persist/root/"
        persist_dirs "$PERSIST_DIR_ROOT" "$MOUNT$REAL_ROOT"  \
            "/var/lib/nixos" \
            "/var/lib/systemd" \
            "/var/log" \
            "/etc/zfs" \
            "/etc/ssh"

    fi

    # set permissions
    sudo chown -R "$USER": "$PERSIST_DIR_HOME"
    if [ -d "$PERSIST_DIR_HOME/.ssh" ]; then
        sudo chmod 700 "$PERSIST_DIR_HOME/.ssh"
        sudo find "$PERSIST_DIR_HOME/.ssh" -type f -exec chmod 600 {} +
        sudo find "$PERSIST_DIR_HOME/.ssh" -type d -exec chmod 700 {} +
    fi

fi

echo "Finished bootstrap task(s)"
