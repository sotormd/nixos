#!/usr/bin/env bash

set -euo pipefail

DIR="$__NIXOS_MOUNT$__NIXOS_GLOBALS_FLAKE"
ROLE="$__NIXOS_ROLE"

VARS_DIR="$DIR/vars"
VARS="$VARS_DIR/vars.nix"

SOPS_DIR="$__NIXOS_MOUNT$__NIXOS_GLOBALS_SOPS"
SECRETS="$VARS_DIR/secrets.yaml"

case "$1" in
    vars)
        "${EDITOR:-vi}" "$VARS"
        ;;
    sops)
        run0 --setenv=GNUPGHOME="$SOPS_DIR" sops "$SECRETS"
        ;;
    *)
    echo "Error: expected argument (vars/sops)" >&2
        exit 1
        ;;
esac
